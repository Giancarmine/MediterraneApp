# Copy to .env, fill in local values, and never commit it.
# Spring Boot does not load .env automatically. Export the variables, use direnv,
# or pass this file to Docker with `docker run --env-file .env ...`.

# PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mediterraneapp
SPRING_DATASOURCE_USERNAME=mediterraneapp
SPRING_DATASOURCE_PASSWORD=change-me

# HTTP port (default 8080)
SERVER_PORT=8080
